# -----------------------------------------------------------------------------
# Every pattern below is anchored (leading "/") to a real, known build-output
# location. Nothing here uses an unanchored/recursive pattern such as bare
# "node_modules/" or "dist/", because packages/engine/fixtures/** deliberately
# vendors fake repos that may themselves contain directories named node_modules,
# dist, .git, etc. to exercise the walker's ignore-handling (A14, Section 8.1).
# An unanchored pattern would silently swallow that fixture content. Do not
# widen a pattern here without checking it still excludes packages/engine/fixtures/.
# -----------------------------------------------------------------------------

# Dependencies. Bun hoists most packages to the workspace root, but it also
# creates per-package node_modules/ directories for workspace-local deps
# (e.g. packages/contract/node_modules/zod), so each level is listed
# explicitly. Still anchored rather than a bare recursive "node_modules/",
# so a fixture repo under packages/engine/fixtures/ may contain its own
# node_modules/ directory for the walker to exercise (A14, Section 8.1).
/node_modules/
/packages/*/node_modules/
/apps/*/node_modules/
/apps/desktop/src-tauri/node_modules/

# TypeScript build output.
# NOTE: this matches the *contents* of dist/ rather than the directory itself
# ("/dist/*" not "/dist/"), because Git cannot re-include a file whose ancestor
# directory is excluded. Matching contents is what makes the negation below work.
/packages/*/dist/*
/apps/desktop/dist/
*.tsbuildinfo

# ...except the emitted JSON Schema, which is a COMMITTED ARTIFACT, not build
# output. Section 14 lists it as "generated, drift-checked": `contract:check-drift`
# compares a fresh emit against the committed bytes, so if this file were ignored
# the Phase 1 drift gate would have nothing to compare against and would pass
# vacuously forever.
!/packages/contract/dist/
!/packages/contract/dist/analysis-result.schema.json

# Rust / Tauri build output
/apps/desktop/src-tauri/target/

# Staged sidecar binaries and grammars (see scripts/stage-sidecar.ts).
# Each compiled sidecar is 60-100 MB and four triples is ~320 MB; Phase 14's
# release workflow builds them in CI, so committing them would bloat every
# clone forever to save one local command. The DIRECTORIES must survive,
# because tauri-build's externalBin resolution requires them to exist — hence
# matching contents (/*) with a .gitkeep negation, not the directory itself.
/apps/desktop/src-tauri/binaries/*
!/apps/desktop/src-tauri/binaries/.gitkeep
/apps/desktop/src-tauri/resources/grammars/*
!/apps/desktop/src-tauri/resources/grammars/.gitkeep

# Compiled engine sidecar binaries (regenerated by scripts/build-sidecar.ts)
/packages/engine/dist/

# Runtime SQLite cache/db files (never the vendored fixtures, which contain no
# SQLite files of their own)
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Coverage reports
/coverage/
/packages/*/coverage/
/apps/desktop/coverage/

# Logs
*.log
npm-debug.log*

# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Local secrets — never committed (see Section 6.2 / Section 12)
.env
.env.*
!.env.example

# Safety net: never let any rule above shadow the vendored fixtures, even if a
# future pattern is added carelessly.
!/packages/engine/fixtures/
!/packages/engine/fixtures/**
