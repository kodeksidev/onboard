{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the single Onboard window. No http: or fs: permission is ever granted — all filesystem access goes through typed Rust commands (Section 12).",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "os:allow-platform",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "onboard-engine",
          "cmd": "onboard-engine",
          "sidecar": true,
          "args": ["--grammars-dir", { "validator": "[^\\r\\n\\u0000]+" }]
        }
      ]
    }
  ]
}
