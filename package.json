{
  "name": "onboard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "verify": "bun run typecheck && bun run lint && bun run contract:check-drift && bun run docs:check && bun run ci:check-installs && bun run test",
    "contract:emit": "bun run --cwd \"packages/contract\" contract:emit",
    "contract:check-drift": "bun run --cwd \"packages/contract\" contract:check-drift",
    "fixture:emit": "bun run --cwd \"packages/contract\" fixture:emit",
    "build:sidecar": "bun run --cwd \"packages/engine\" build:sidecar",
    "stage:sidecar": "bun run scripts/stage-sidecar.ts",
    "typecheck": "bun run --cwd \"packages/contract\" typecheck && bun run --cwd \"packages/engine\" typecheck && bun run --cwd \"apps/desktop\" typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun run --cwd \"packages/contract\" test && bun run --cwd \"packages/engine\" test && bun run --cwd \"apps/desktop\" test",
    "docs:check": "python scripts/docs-check.py",
    "ci:check-installs": "python scripts/ci-install-check.py"
  },
  "overrides": {
    "brace-expansion": ">=5.0.8",
    "serialize-javascript": ">=7.0.7"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.0",
    "@typescript-eslint/eslint-plugin": "~8.65.0",
    "@typescript-eslint/parser": "~8.65.0",
    "@types/node": "~22.20.0",
    "bun-types": "~1.3.14",
    "eslint": "~9.39.0",
    "prettier": "~3.9.6",
    "typescript": "~5.7.3",
    "typescript-eslint": "~8.65.0"
  }
}
